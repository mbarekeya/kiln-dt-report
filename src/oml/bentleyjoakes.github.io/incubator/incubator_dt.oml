description <https://bentleyjoakes.github.io/incubator/incubator_dt#> as incubator_dt {

	uses <https://bentleyjoakes.github.io/DTDF/vocab/DTDFVocab#> as DTDFVocab
	uses <https://bentleyjoakes.github.io/DTDF/vocab/base#> as base
	extends <https://bentleyjoakes.github.io/DTDF/desc/baseDesc#> as baseDesc
	extends <https://bentleyjoakes.github.io/incubator/incubator_pt#> as pt

	instance WoodTwin : DTDFVocab:DigitalTwin [
		DTDFVocab:purpose "build kiln loads from the packages already produced, estimate and monitor the moisture content of the load during drying, and let operators validate their decisions before executing them"
		DTDFVocab:multiplicity 1
	]

	// SERVICES (C6)

	instance kiln_loading_optimization_service : DTDFVocab:Service [
		DTDFVocab:provides loading_plans
		DTDFVocab:provides validated_load
		DTDFVocab:atStage baseDesc:operation
		base:desc "Builds the available inventory from the package records and computes one loading plan per lumber dimension with a lexicographic MILP"
	]
	instance mc_estimation_service : DTDFVocab:Service [
		DTDFVocab:provides estimated_mc
		DTDFVocab:atStage baseDesc:operation
		base:desc "Estimates the MC of the load from the dry-bulb and wet-bulb temperatures and compares it with the planned MC"
	]
	instance monitoring_service : DTDFVocab:Service [
		DTDFVocab:provides monitoring_dashboard
		DTDFVocab:provides cycle_report
		DTDFVocab:provides drying_recommendation
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:HasVisualization true
		base:desc "Web dashboard to request and validate loading plans, follow the drying cycle, and review recommendations"
	]
	instance visualization_3d_service : DTDFVocab:Service [
		DTDFVocab:provides kiln_3d_view
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:HasVisualization true
		base:desc "3D view of the kiln reproducing the arrangement of the validated load"
	]

	// ENABLERS (C11)

	instance production_data_collector : DTDFVocab:Enabler [
		DTDFVocab:IsCommEnabler true
		DTDFVocab:enables kiln_loading_optimization_service
		base:desc "Collects the package records from the production monitoring system of the sawmill"
	]
	instance rabbit_mq : DTDFVocab:Enabler [
		DTDFVocab:IsCommEnabler true
		DTDFVocab:enables kiln_loading_optimization_service
		DTDFVocab:enables mc_estimation_service
		DTDFVocab:enables monitoring_service
		DTDFVocab:enables visualization_3d_service
		base:desc "RabbitMQ AMQP broker; services communicate only through it (RPC queues)"
	]
	instance docker : DTDFVocab:Enabler [
		DTDFVocab:enables kiln_loading_optimization_service
		DTDFVocab:enables mc_estimation_service
		DTDFVocab:enables monitoring_service
		base:desc "Docker Compose; one container per service and one for the broker"
	]
	instance highs : DTDFVocab:Enabler [
		DTDFVocab:enables kiln_loading_optimization_service
		base:desc "HiGHS MILP solver called through SciPy"
	]
	instance godot : DTDFVocab:Enabler [
		DTDFVocab:enables visualization_3d_service
		base:desc "Godot 4 C# client for the 3D view of the kiln"
	]
	instance simulator : DTDFVocab:Enabler [
		DTDFVocab:enables mc_estimation_service
		DTDFVocab:enables monitoring_service
		base:desc "Kiln simulator following the drying schedules of the sawmill; replaces the kiln controllers until they are accessible"
	]

	// MODELS / DATA

	instance loading_milp_model : DTDFVocab:Model [
		DTDFVocab:inputTo highs
		base:desc "Column-based MILP: columns of four packages of the same length placed in lanes; maximizes the loaded volume, then prioritizes the oldest packages"
	]
	instance drying_model : DTDFVocab:Model [
		DTDFVocab:inputTo simulator
		base:desc "Falling-rate drying kinetics dMC/dt = -k(MC - EMC) with Hailwood-Horrobin EMC; k not yet calibrated"
	]
	instance drying_schedule_model : DTDFVocab:Model [
		DTDFVocab:inputTo simulator
		base:desc "Drying schedules of the sawmill for spruce and jack pine, target MC 15 %"
	]
	instance kiln_3d_model : DTDFVocab:Model [
		DTDFVocab:inputTo godot
		base:desc "3D scene of the kiln with lanes and lumber packages"
	]
	instance package_data : DTDFVocab:Data [
		DTDFVocab:inputTo production_data_collector
		DTDFVocab:fromData pt:package_records_trans
		base:desc "Package records stored by the collector and used to build the inventory"
	]
	instance kiln_log_data : DTDFVocab:Data [
		DTDFVocab:inputTo  simulator
		DTDFVocab:fromData pt:kiln_log_trans
		DTDFVocab:fromData pt:mc_tests_trans
		base:desc "Kiln log of the sawmill, used to analyse losses and over-drying and, in future work, to calibrate the drying model"
	]
	instance fastapi : DTDFVocab:Enabler [
		DTDFVocab:enables monitoring_service
		base:desc "Python FastAPI web server of the monitoring dashboard; relays operator requests to the services through RabbitMQ"
	]
	instance simulated_temperature_data : DTDFVocab:Data [
		DTDFVocab:inputTo rabbit_mq
		base:desc "Dry-bulb and wet-bulb temperatures generated by the simulator and sent to the MC estimation service; will be replaced by the measured temperatures once the kiln controllers are accessible"
	]
	// INSIGHTS / ACTIONS (C17)

	instance loading_plans : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "One loading plan per dimension with its loaded volume, lane fill, and mean package age"
	]
	instance estimated_mc : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		base:desc "Estimated MC and its deviation from the planned MC during the drying cycle"
	]
	instance monitoring_dashboard : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		base:desc "Dashboard showing the loading plans, MC curves, drying progress, and recommendations"
	]
	instance kiln_3d_view : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		base:desc "3D view of the validated load inside the kiln"
	]
	instance cycle_report : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "Report generated at the end of the cycle"
	]
	instance validated_load : DTDFVocab:Action [
		DTDFVocab:IsAutomatic false
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "Loading plan validated by the planner and applied manually in the yard"
	]
	instance drying_recommendation : DTDFVocab:Action [
		DTDFVocab:IsAutomatic false
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "Recommendations to the kiln operator, who can review or override them; no command is sent to the kiln"
	]

	// DT CHARACTERISTICS

	instance virtual_to_physical : DTDFVocab:VirtualToPhysical [
		base:desc "Manual: loading plans and drying recommendations are applied by operators. No command is sent to the kiln."
	]
	instance twinning_time_scale : DTDFVocab:TimeScale [
		base:desc "Package records collected automatically; loading plans computed on request in about 1 s; simulated temperatures and MC estimates updated continuously during the cycle."
	]
	instance multiplicity : DTDFVocab:Multiplicity [
		base:desc "One DT covering the stacking line, the yard, and one studied kiln; extension to the five kilns of the sawmill is planned."
	]
	instance life_cycle_stage : DTDFVocab:LifeCycleStage [
		base:desc "Operation stage: preparation of kiln loads and follow-up of the drying cycle."
	]
	instance constellation : DTDFVocab:Constellation [
		base:desc "Services in Docker containers communicating only through RabbitMQ; Godot client on the host machine; production data collected from the sawmill production monitoring system."
	]
	instance evolution_stage : DTDFVocab:EvolutionStage [
		base:desc "Inventory and loading side: digital shadow (automatic flow from the plant, manual return). Kiln side: digital model (simulated data). Connection to the kiln controllers is planned to close both loops."
	]
	instance fidelity_consideration : DTDFVocab:FidelityConsideration [
		base:desc "Inventory built from production records, without transfers between yards. Drying constant k not calibrated, since the MC is not measured during drying. MC model not validated against measured data."
	]
	instance technical_connection : DTDFVocab:TechnicalConnection [
		base:desc "Automatic collection of package records from the production monitoring system; AMQP (RabbitMQ) between services; no connection to the kiln controllers yet."
	]
	instance deployment : DTDFVocab:Deployment [
		base:desc "Deployed locally with Docker Compose."
	]
	instance horizontal_integration : DTDFVocab:HoriIntegration [
		base:desc "Integrated with the production monitoring system of the sawmill; not yet with the planning system or the kiln controllers."
	]
	instance data_ownership_privacy : DTDFVocab:DataOwnershipPrivacy [
		base:desc "Production and kiln data belong to the industrial partner and are used within an academic collaboration; the partner is not named."
	]
	instance standardization : DTDFVocab:Standardization [
		base:desc "Architecture aligned with ISO 23247; communication via AMQP (RabbitMQ) with JSON payloads."
	]
	instance security_safety : DTDFVocab:SecuritySafety [
		base:desc "No physical safety risk: no command is sent to the kiln, and all decisions remain with the operators."
	]
}

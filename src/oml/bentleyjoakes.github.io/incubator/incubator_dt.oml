description <https://bentleyjoakes.github.io/incubator/incubator_dt#> as incubator_dt {

	uses <https://bentleyjoakes.github.io/DTDF/vocab/DTDFVocab#> as DTDFVocab
	uses <https://bentleyjoakes.github.io/DTDF/vocab/base#> as base
	extends <https://bentleyjoakes.github.io/DTDF/desc/baseDesc#> as baseDesc
	extends <https://bentleyjoakes.github.io/incubator/incubator_pt#> as pt

	instance WoodTwin : DTDFVocab:DigitalTwin [
		DTDFVocab:purpose "build kiln loads from the packages already produced, estimate and monitor the moisture content of the load during drying, and let operators validate their decisions before executing them"
		DTDFVocab:multiplicity 1
	]

	// SERVICES (C6)

	instance kiln_loading_optimization_service : DTDFVocab:Service [
		DTDFVocab:provides loading_plans
		DTDFVocab:provides validated_load
		DTDFVocab:atStage baseDesc:operation
		base:desc " computes one loading plan per lumber dimension (2x4, 2x6, 2x8) with a lexicographic MILP"
	]
	instance mc_estimation_service : DTDFVocab:Service [
		DTDFVocab:provides estimated_mc
		DTDFVocab:atStage baseDesc:operation
		base:desc "Estimates the MC of the load from the dry-bulb and wet-bulb temperatures of the kiln and compares it with the planned MC"
	]
	instance monitoring_service : DTDFVocab:Service [
		DTDFVocab:provides monitoring_dashboard
		DTDFVocab:provides cycle_report
		DTDFVocab:provides drying_recommendation
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:HasVisualization true
		base:desc "Web dashboard where operators request and validate loading plans, follow the drying cycle, and review recommendations"
	]
	instance visualization_3d_service : DTDFVocab:Service [
		DTDFVocab:provides kiln_3d_view
		DTDFVocab:atStage baseDesc:operation
		DTDFVocab:HasVisualization true
		base:desc "3D view of the kiln reproducing the arrangement of the validated load"
	]

	// ENABLERS (C11)

	instance production_data_collector : DTDFVocab:Enabler [
		DTDFVocab:IsCommEnabler true
		DTDFVocab:enables kiln_loading_optimization_service
		base:desc "Collects the package records from the production monitoring system of the sawmill every hour"
	]
	instance rabbit_mq : DTDFVocab:Enabler [
		DTDFVocab:IsCommEnabler true
		base:desc "RabbitMQ message broker carrying all messages between the data manager, the services, and the 3D client"
	]
	instance data_manager : DTDFVocab:Enabler [
		DTDFVocab:enables kiln_loading_optimization_service
		DTDFVocab:enables mc_estimation_service
		DTDFVocab:enables monitoring_service
		DTDFVocab:enables visualization_3d_service
		base:desc "Only accessor of the database: derives the available inventory from the package records and the validated loads, receives the kiln temperatures and the estimated MC during drying, and provides these data to the services"
		]
	instance sqlite_database : DTDFVocab:Enabler [
		base:desc "SQLite database storing the package records, the validated loads, and the kiln state"
	]
	instance docker : DTDFVocab:Enabler [
		DTDFVocab:enables kiln_loading_optimization_service
		DTDFVocab:enables mc_estimation_service
		DTDFVocab:enables monitoring_service
		base:desc "Docker containers: one container per service and one for the message broker"
	]
	instance highs : DTDFVocab:Enabler [
		DTDFVocab:enables kiln_loading_optimization_service
		base:desc "HiGHS MILP solver called through SciPy"
	]
	instance godot : DTDFVocab:Enabler [
		DTDFVocab:enables visualization_3d_service
		base:desc "Godot game engine used for the 3D view of the kiln"
	]
	instance fastapi : DTDFVocab:Enabler [
		DTDFVocab:enables monitoring_service
		base:desc "Python FastAPI web server of the dashboard; relays operator requests to the services through RabbitMQ"
	]
	instance simulator : DTDFVocab:Enabler [
		DTDFVocab:enables mc_estimation_service
		base:desc "Kiln simulator following the drying schedules of the sawmill; generates the dry-bulb and wet-bulb temperatures of the kiln and sends them to the data manager"
	]

	// MODELS / DATA (C10)

	instance loading_milp_model : DTDFVocab:Model [
		DTDFVocab:inputTo highs
		base:desc "Column-based MILP: columns of four packages of the same length placed in the kiln lanes; maximizes the loaded volume, then prioritizes the oldest packages"
	]
	instance mc_kinetics_model : DTDFVocab:Model [
		DTDFVocab:inputTo simulator
		base:desc "MC kinetics of the lumber: dMC/dt = -k(MC - EMC) with Hailwood-Horrobin EMC"
	]
	instance kiln_schedule_model : DTDFVocab:Model [
		DTDFVocab:inputTo simulator
		base:desc "Drying recipe of the sawmill: dry-bulb and wet-bulb temperature setpoints per phase"
	]
	instance kiln_3d_model : DTDFVocab:Model [
		DTDFVocab:inputTo godot
		base:desc "3D scene of the kiln with its lanes and lumber packages"
	]
	instance package_data : DTDFVocab:Data [
		DTDFVocab:inputTo sqlite_database
		DTDFVocab:inputTo data_manager
		DTDFVocab:fromData pt:package_records_trans
		base:desc "Package records used to build the inventory available for kiln loading"
	]
	instance simulated_temperature_data : DTDFVocab:Data [
		DTDFVocab:inputTo data_manager
		base:desc "Dry-bulb and wet-bulb temperatures generated by the simulator and provided by the data manager to the MC estimation service"
	]
	instance kiln_log_data : DTDFVocab:Data [
		DTDFVocab:inputTo simulator
		DTDFVocab:fromData pt:kiln_log_trans
		DTDFVocab:fromData pt:mc_tests_trans
		base:desc "Kiln log of the sawmill: unused kiln length, MC at the final test, and cycle durations recorded for the studied kiln"
	]

	// INSIGHTS / ACTIONS (C17)

	instance loading_plans : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "One loading plan per dimension with its loaded volume, lane fill, and mean package age"
	]
	instance estimated_mc : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		base:desc "Estimated MC and its deviation from the planned MC during the drying cycle"
	]
	instance monitoring_dashboard : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		base:desc "Dashboard showing the loading plans, the estimated and planned MC, the drying progress, and recommendations"
	]
	instance kiln_3d_view : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:rt
		base:desc "3D view of the validated load inside the kiln"
	]
	instance cycle_report : DTDFVocab:Insight [
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "Report generated at the end of the drying cycle"
	]
	instance validated_load : DTDFVocab:Action [
		DTDFVocab:IsAutomatic false
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "Loading plan selected and validated by the planner, then applied manually"
	]
	instance drying_recommendation : DTDFVocab:Action [
		DTDFVocab:IsAutomatic false
		DTDFVocab:hasTimeScale baseDesc:slower_trt
		base:desc "Recommendations to the kiln operator during the cycle, who can review or override them"
	]

	// DT CHARACTERISTICS

	// C5
	instance virtual_to_physical : DTDFVocab:VirtualToPhysical [
		base:desc "Manual: loading plans and drying recommendations are applied by the operators. No command is sent to the kiln."
	]
	// C7
	instance twinning_time_scale : DTDFVocab:TimeScaleDescription [
		base:desc "Package records collected automatically every hour; loading plans computed on request in 0.88 s on average; other requests answered in less than 0.06 s; simulated temperatures and MC estimates updated continuously during the drying cycle."
	]
	// C8
	instance multiplicity : DTDFVocab:Multiplicity [
		base:desc "One DT for the drying operations of one kiln, from the stacking line to the end of the drying cycle."
	]
	// C9
	instance life_cycle_stage : DTDFVocab:LifeCycleStage [
		base:desc "Operation stage: preparation of kiln loads and follow-up of the drying cycle."
	]
	// C12
	instance constellation : DTDFVocab:Constellation [
		base:desc "Services in Docker containers communicating only through RabbitMQ; a data manager is the only accessor of the SQLite database; Godot client on the host machine; package records collected from the production monitoring system of the sawmill."
	]
	// C13
	instance evolution_stage : DTDFVocab:EvolutionStage [
		base:desc "Architecture based on ISO 23247. Inventory and loading side: digital shadow (automatic flow from the plant, decisions applied by operators). Kiln side: digital model (simulated temperatures and MC)."
	]
	// C14
	instance fidelity_consideration : DTDFVocab:FidelityConsideration [
		base:desc "The inventory is built from production records and does not account for packages received from other mills. The drying constant k of the MC model is not calibrated, since the MC is not measured during drying."
	]
	// C15
	instance technical_connection : DTDFVocab:TechnicalConnection [
		base:desc "Automatic hourly collection of package records from the production monitoring system; AMQP (RabbitMQ) between services. The kiln controller is not connected to the DT."
	]
	// C16
	instance deployment : DTDFVocab:Deployment [
		base:desc "Deployed locally on a laptop with Docker containers."
	]
	// C18
	instance horizontal_integration : DTDFVocab:HoriIntegration [
		base:desc "Integrated with the production monitoring system of the sawmill. The planning system and the kiln controller are not connected to the DT."
	]
	// C19
	instance data_ownership_privacy : DTDFVocab:DataOwnershipPrivacy [
		base:desc "Production and kiln data belong to the industrial partner and are used within an academic collaboration."
	]
	// C20
	instance standardization : DTDFVocab:Standardization [
		base:desc "Architecture aligned with ISO 23247; communication via AMQP (RabbitMQ) with JSON payloads."
	]
	// C21
	instance security_safety : DTDFVocab:SecuritySafety [
		base:desc "No command is sent to the kiln, and all decisions remain with the operators."
	]
}
